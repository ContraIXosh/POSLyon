```typescript
import { synchronize } from '@nozbe/watermelondb/sync';
import { Database } from '@nozbe/watermelondb';

export class WatermelonSyncAdapter {
  constructor(
    private readonly db: Database,
    private readonly apiBaseUrl: string,
    private readonly sucursalId: string
  ) {}

  /**
   * Ejecuta el ciclo pull/push oficial de WatermelonDB con reintentos y tolerancia a fallos.
   */
  async sincronizar(): Promise<void> {
    await synchronize({
      database: this.db,
      pullChanges: async ({ lastPulledAt, schemaVersion, migration }) => {
        const response = await fetch(
          `${this.apiBaseUrl}/api/sync/pull?last_pulled_at=${lastPulledAt || 0}&sucursal_id=${this.sucursalId}`
        );
        if (!response.ok) {
          throw new Error(`Fallo en pull: ${response.statusText}`);
        }
        const { changes, timestamp } = await response.json();
        return { changes, timestamp };
      },
      pushChanges: async ({ changes, lastPulledAt }) => {
        // Regla C-16: Filtrado estricto hacia la Nube.
        // Únicamente se sincronizan a PostgreSQL las ventas en estado CONFIRMADA.
        // Los carritos en BORRADOR y CANCELADA residen exclusivamente en SQLite local.
        const ventasConfirmadas = (changes.ventas?.created || []).filter(
          (v: any) => v.estado_general === 'CONFIRMADA'
        );
        const idsVentasValidas = new Set(ventasConfirmadas.map((v: any) => v.id));

        const detallesFiltrados = (changes.venta_detalles?.created || []).filter(
          (d: any) => idsVentasValidas.has(d.id_venta)
        );

        const pagosFiltrados = (changes.pagos_venta?.created || []).filter(
          (p: any) => idsVentasValidas.has(p.id_venta)
        );

        const changesFiltrados = {
          ...changes,
          ventas: { ...changes.ventas, created: ventasConfirmadas },
          venta_detalles: { ...changes.venta_detalles, created: detallesFiltrados },
          pagos_venta: { ...changes.pagos_venta, created: pagosFiltrados },
        };

        const response = await fetch(`${this.apiBaseUrl}/api/sync/push`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            sucursal_id: this.sucursalId,
            last_pulled_at: lastPulledAt,
            changes: changesFiltrados,
          }),
        });
        if (!response.ok) {
          throw new Error(`Fallo en push: ${response.statusText}`);
        }
      },
      migrationsExperimental: false,
    });
  }
}
